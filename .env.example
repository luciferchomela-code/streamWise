GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=postmessage
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id

CLOUD_NAME=your-cloudinary-cloud-name
CLOUD_API_KEY=your-cloudinary-api-key
CLOUD_SECRET_KEY=your-cloudinary-api-secret

# Project infrastructure
NODE_ENV=development
MONGO_URL=mongodb://mongo:27017/streamwise?replicaSet=rs0
MONGO_DB_NAME=streamwise
REDIS_URL=redis://localhost:6379
USE_REDIS=true
RABBITMQ_URL=amqp://streamwise:streamwise-local@localhost:5672
RABBITMQ_USER=streamwise
RABBITMQ_PASSWORD=streamwise-local
COMPOSE_RABBITMQ_URL=amqp://streamwise:streamwise-local@rabbitmq:5672
RABBITMQ_EXCHANGE=youtube.events

# Gateway / service URLs
PORT=5000
AUTH_SERVICE_URL=http://localhost:5001
VIDEO_METADATA_SERVICE_URL=http://localhost:5002
UPLOAD_SERVICE_URL=http://localhost:5003

# Comma-separated exact frontend origins for a deployed gateway
ALLOWED_FRONTEND_ORIGINS=
# Optional comma-separated IPs or CIDRs of trusted reverse proxies
TRUSTED_PROXY_ADDRESSES=

# Comma-separated MongoDB account IDs allowed to review reports
MODERATOR_USER_IDS=

# Comma-separated MongoDB account IDs allowed to view platform playback health
PLAYBACK_OPERATOR_USER_IDS=

# Mux Video API credentials for OBS broadcasting and recordings
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
