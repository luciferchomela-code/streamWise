GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=postmessage
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id

CLOUD_NAME=your-cloudinary-cloud-name
CLOUD_API_KEY=your-cloudinary-api-key
CLOUD_SECRET_KEY=your-cloudinary-api-secret

# Project infrastructure
NODE_ENV=development
MONGO_URL=mongodb://localhost:27017/youtube_clone
MONGO_DB_NAME=streamwise
REDIS_URL=redis://localhost:6379
USE_REDIS=true
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=youtube.events

# Gateway / service URLs
PORT=5000
AUTH_SERVICE_URL=http://localhost:5001
VIDEO_METADATA_SERVICE_URL=http://localhost:5002
UPLOAD_SERVICE_URL=http://localhost:5003
